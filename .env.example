# ───────────────────────────────────────────────────────────────────────
# TTS Backend — Environment Variables
# Copy this file to understand what needs to be set.
# NEVER commit real secrets. Set these in the systemd service environment.
#
# To edit live env vars:
#   sudo systemctl edit tts.service
#   (add Environment= lines under [Service])
#   sudo systemctl restart tts.service
# ───────────────────────────────────────────────────────────────────────

# ── Mode selector ────────────────────────────────────────────────────
# The ONLY thing you change to switch between sandbox and production.
# dev  → uses sandbox Stripe keys, logs verbosely
# prod → uses live Stripe keys
APP_ENV=dev

# ── Stripe ────────────────────────────────────────────────────────
# Keep BOTH sets of keys present at all times.
# Get keys from: https://dashboard.stripe.com/apikeys
# Get webhook secrets from: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY_DEV=sk_test_...
STRIPE_WEBHOOK_SECRET_DEV=whsec_...
STRIPE_SECRET_KEY_PROD=sk_live_...
STRIPE_WEBHOOK_SECRET_PROD=whsec_...

# Stripe coupon ID for review discount (from Stripe Dashboard > Coupons)
# Leave blank if not using discounts this season
STRIPE_REVIEW_COUPON_ID=

# ── Gmail (for error alerts + estimate emails) ────────────────────
# GMAIL_SEND_AS: the Google Workspace address to send from
# GMAIL_APP_PASSWORD: an App Password (not your login password)
#   Generate at: https://myaccount.google.com/apppasswords
#   (Requires 2FA enabled on the account)
GMAIL_SEND_AS=hello@tistheseasonkc.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Error notifications ──────────────────────────────────────────
# Email address to notify when a checkout or webhook error occurs.
# Defaults to stetson@tts.lighting if not set.
ERROR_EMAIL_TO=stetson@tts.lighting
