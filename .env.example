# ───────────────────────────────────────────────────────────────────────
# TTS Backend — Environment Variables Reference
# This file documents what vars are required. It contains no real secrets.
#
# Real secrets live at: /etc/tts/secrets.env  (root-only, mode 600)
#
# To add or rotate a secret:
#   sudo nano /etc/tts/secrets.env
#   sudo systemctl daemon-reload && sudo systemctl restart tts.service
# ───────────────────────────────────────────────────────────────────────

# ── Mode selector ────────────────────────────────────────────────────
# The ONLY thing you change to switch between sandbox and production.
# dev  → uses sandbox Stripe keys, logs verbosely
# prod → uses live Stripe keys
APP_ENV=dev

# ── Stripe ────────────────────────────────────────────────────────
# Stripe API keys are NOT stored here.
# Outbound Stripe calls go through exe.dev HTTP proxy integrations:
#   dev  → stripe-test-mode.int.exe.xyz  (sandbox)
#   prod → stripe-prod.int.exe.xyz  (live)
#
# Webhook secrets ARE needed here because they verify inbound requests
# from Stripe (not outbound), so the proxy can't help.
# Get these from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET_DEV=whsec_...
STRIPE_WEBHOOK_SECRET_PROD=whsec_...

# Stripe coupon ID for review discount (from Stripe Dashboard > Coupons)
# Leave blank if not using discounts this season
STRIPE_REVIEW_COUPON_ID=

# Stripe product used by the Airtable "Make Invoice" automation.
# Product IDs are not secrets, but test/live product IDs are different.
STRIPE_INVOICE_PRODUCT_ID_DEV=prod_Uc6pEX6LZHcEcL # 1st year holiday lighting in sandbox
STRIPE_INVOICE_PRODUCT_ID_PROD=prod_...

# Webhook auth shared with Airtable automation scripts.
# Airtable sends this as: Authorization: Bearer <value>
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WEBHOOK_AUTH_KEY=<random-32-byte-url-safe-token>

# ── CompanyCam ────────────────────────────────────────────────────
# On exe.dev, auth is injected by the companycam.int.exe.xyz proxy —
# no token or user email needed. The default base URL points to the proxy.
# Override COMPANYCAM_BASE_URL for local dev only.
# COMPANYCAM_BASE_URL=https://api.companycam.com/v2
# COMPANYCAM_API_TOKEN=<your CompanyCam personal access token — local dev only>
# COMPANYCAM_USER_EMAIL=<your CompanyCam account email — local dev only>

# ── Gmail (for error alerts + estimate emails) ────────────────────
# GMAIL_USER: optional SMTP authentication account. Defaults to GMAIL_SEND_AS.
# GMAIL_SEND_AS: the Google Workspace address/alias shown as the sender.
# GMAIL_APP_PASSWORD: an App Password (not your login password).
#   Generate at: https://myaccount.google.com/apppasswords
#   (Requires 2FA enabled on the authentication account.)
GMAIL_USER=
GMAIL_SEND_AS=hello@tts.lighting
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# EMAIL_TEST_TO: optional test-recipient override. When set, ALL automated
# customer emails (estimate, confirmation, out-of-service) are delivered to
# this address instead of the lead's email. Leave empty for normal sending.
EMAIL_TEST_TO=

# ── Internal tools and analytics ──────────────────────────────────
# Private internal-tools listener; default is 3001. Set to 0 to disable.
INTERNAL_PORT=3001

# Self-hosted Umami upstream. The variable spelling matches the code.
UMIAMI_URL=http://127.0.0.1:3000

# ── Error notifications ──────────────────────────────────────────
# Email address to notify when a checkout or webhook error occurs.
# Defaults to stetson@tts.lighting if not set.
ERROR_EMAIL_TO=stetson@tts.lighting

# ── Sentry (backend error/panic monitoring) ─────────────────────
# Optional — leave blank to disable. When set, panics and every sendErrorEmail
# alert (checkout/webhook/invoice/sold-sync failures) are also reported to
# Sentry with stack traces. Free tier: 5K errors/mo.
SENTRY_DSN=https://<publickey>@o<org>.ingest.us.sentry.io/<project>
